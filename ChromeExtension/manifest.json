{
  "manifest_version": 3,
  "name": "StayPane Chrome Companion",
  "description": "Local tab activation enforcement for StayPane sessions.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": [
    "favicon",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "StayPane Chrome Companion"
  }
}
